# 医保对账差异归因系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意: .env 文件不应提交到版本控制

# ===== API配置 (预留，未来可能需要) =====
# OPENAI_API_KEY=your_api_key_here
# ANTHROPIC_API_KEY=your_api_key_here

# ===== 数据源配置 (预留) =====
# HIS_DATABASE_URL=postgresql://user:password@localhost:5432/his_db
# INSURANCE_DATABASE_URL=postgresql://user:password@localhost:5432/insurance_db

# ===== 报告输出配置 =====
# OUTPUT_DIR=reports/output
# REPORT_FORMAT=xlsx,docx,html,json

# ===== 日志配置 =====
# LOG_LEVEL=INFO
# LOG_FILE=logs/reconciliation.log

# ===== 高级配置 =====
# ENABLE_CACHE=true
# PARALLEL_PROCESSING=false
# MAX_WORKERS=4
